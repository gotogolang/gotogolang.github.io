# Copy to .env and fill in before running `make up`

# JWT signing secret — change in production
JWT_SECRET=change-me-in-production

# Absolute host path to exercises directory
# (Docker resolves bind mounts from the host, not from inside containers)
EXERCISES_HOST_PATH=/path/to/goalgo/exercises

# CORS — set to your GitHub Pages domain in production
CORS_ORIGINS=https://goalgo.github.io
